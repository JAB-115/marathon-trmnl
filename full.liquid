    <path d="M17.4 17.4 L19.4 19.4"/><path d="M6.6 6.6 L4.6 4.6"/>
  </g>
</svg>
{%- endcapture -%}
{%- capture icon_gel -%}
<img class="image" width="20" height="34" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABQAAAAiAQAAAAB30cQQAAAAaElEQVR42j3KsQ2DMBgF4fufLeTSI3gERmAsulgZAKFMFMQaFIzg0oogpHDESV93VCuqF4ImGPIvOFzRMaF6ZZbQa/3sBMMHRoiI9DcgClhC9gUv5J64s9sgAjO6/zcYrUjGQA+iBtIPpdIW19NjZxkAAAAASUVORK5CYII=" />
{%- endcapture -%}
{%- capture icon_bottle -%}
<img class="image" width="16" height="34" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAiAQAAAAB+OmRqAAAAQElEQVR42mXLMRGAMBAAwfv7lMxgIRJQgLZgBSUvCQVAQZVh++VaXbb05FMpWHc8TEYIcSA0d1sXBLKSzs/UR7xVLglGvGXKFAAAAABJRU5ErkJggg==" />
{%- endcapture -%}
