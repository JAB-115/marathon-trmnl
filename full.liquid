{%- comment -%} ---- CLOCK ---- {%- endcomment -%}
{%- assign local = trmnl.system.timestamp_utc | plus: trmnl.user.utc_offset -%}
{%- assign today = local | date: "%Y-%m-%d" -%}
{%- assign now_h = local | date: "%H" | times: 1 -%}
{%- assign now_hhmm = local | date: "%H:%M" -%}

{%- comment -%} ---- SOURCES: IDX_0 = plan, IDX_1 = Open-Meteo. Order is frozen. ---- {%- endcomment -%}
{%- assign plan = IDX_0 -%}
{%- assign wx = IDX_1 -%}

{%- assign day = plan.days | where: "date", today | first -%}
{%- assign wk = plan.weeks | where: "n", day.week | first -%}
{%- assign hr = day.hour | default: now_h -%}

{%- comment -%} ---- DONE: plan.completed is a list of ISO dates, written by the Strava job ---- {%- endcomment -%}
{%- assign is_done = false -%}
{%- if plan.completed contains today -%}{%- assign is_done = true -%}{%- endif -%}

{%- comment -%} ---- WEATHER: hourly index == hour of day when timezone is set.
     Display and band come from the current hour. Modifiers come from the run hour. ---- {%- endcomment -%}
{%- assign has_wx = false -%}
{%- if wx.hourly.temperature_2m -%}{%- assign has_wx = true -%}{%- endif -%}
{%- if has_wx -%}
  {%- assign now_temp = wx.hourly.temperature_2m[now_h] -%}
  {%- assign now_wind = wx.hourly.wind_speed_10m[now_h] -%}
  {%- assign now_precip = wx.hourly.precipitation[now_h] -%}
  {%- assign now_uv = wx.hourly.uv_index[now_h] -%}
  {%- assign run_temp = wx.hourly.temperature_2m[hr] -%}
  {%- assign run_precip = wx.hourly.precipitation[hr] -%}
  {%- assign run_wind = wx.hourly.wind_speed_10m[hr] -%}
  {%- assign sunrise_t = wx.daily.sunrise[0] | split: "T" | last -%}
  {%- assign sunset_t = wx.daily.sunset[0] | split: "T" | last -%}
  {%- assign sunrise_h = sunrise_t | split: ":" | first | times: 1 -%}
  {%- assign sunset_h = sunset_t | split: ":" | first | times: 1 -%}
{%- endif -%}

{%- comment -%} ---- BAND from current temperature ---- {%- endcomment -%}
{%- assign eff = now_temp -%}
{%- if has_wx and now_wind >= 25 -%}
  {%- assign eff = now_temp | minus: 4 -%}
{%- endif -%}
{%- assign band = "" -%}
{%- assign band_label = "" -%}
{%- if has_wx -%}
  {%- for b in plan.kit.bands -%}
    {%- if band == "" and eff <= b.max -%}
      {%- assign band = b.id -%}
      {%- assign band_label = b.label -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign band_deltas = plan.kit.deltas | where: "band", band -%}
{%- assign delta = band_deltas | where: "kit", day.kit | first -%}

{%- comment -%} ---- MODIFIERS from the run hour ---- {%- endcomment -%}
{%- assign mods = "" -%}
{%- if has_wx -%}
  {%- if hr >= sunset_h or hr <= sunrise_h -%}
    {%- assign mods = mods | append: "|" | append: plan.kit.modifiers.dark -%}
  {%- endif -%}
  {%- if run_precip >= 1.5 -%}
    {%- assign mods = mods | append: "|" | append: plan.kit.modifiers.heavy_rain -%}
  {%- elsif run_precip >= 0.2 -%}
    {%- assign mods = mods | append: "|" | append: plan.kit.modifiers.light_rain -%}
  {%- endif -%}
  {%- assign base_text = delta.lines | join: " " -%}
  {%- unless base_text contains "windproof" -%}
    {%- if run_wind >= 25 -%}
      {%- assign mods = mods | append: "|" | append: plan.kit.modifiers.wind -%}
    {%- endif -%}
  {%- endunless -%}
  {%- if run_precip >= 0.2 and day.km >= 15 -%}
    {%- assign mods = mods | append: "|" | append: plan.kit.modifiers.any_rain_long -%}
  {%- endif -%}
{%- endif -%}
{%- assign modlist = mods | remove_first: "|" | split: "|" -%}
{%- assign mod_cap = plan.kit.mod_cap | default: 3 -%}
{%- assign max_lines = plan.kit.max_lines | default: 4 -%}
{%- assign shown_mods = modlist.size -%}
{%- if shown_mods > mod_cap -%}{%- assign shown_mods = mod_cap -%}{%- endif -%}
{%- assign slots = max_lines | minus: shown_mods -%}
{%- if slots < 1 -%}{%- assign slots = 1 -%}{%- endif -%}

{%- comment -%} ---- FLUID AND FUEL ---- {%- endcomment -%}
{%- assign supply = "" -%}
{%- if day.mins >= 75 -%}
  {%- if band == "warm" or band == "hot" -%}
    {%- assign supply = plan.kit.modifiers.fluid -%}
  {%- endif -%}
{%- endif -%}
{%- if day.fuel -%}
  {%- if supply == "" -%}
    {%- assign supply = plan.kit.modifiers.fuel -%}
  {%- else -%}
    {%- assign supply = supply | append: " &middot; " | append: plan.kit.modifiers.fuel -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%} ---- ICE ---- {%- endcomment -%}
{%- assign ice = false -%}
{%- if has_wx and run_temp < 2 and run_precip > 0 -%}{%- assign ice = true -%}{%- endif -%}
{%- assign shoe_id = day.shoe -%}
{%- if ice -%}{%- assign shoe_id = "parkclaw_g280" -%}{%- endif -%}
{%- assign shoe = plan.shoes | where: "id", shoe_id | first -%}

{%- comment -%} ---- NEXT RUN ---- {%- endcomment -%}
{%- assign seen = false -%}
{%- assign found = false -%}
{%- for dd in plan.days -%}
  {%- if dd.date == today -%}
    {%- assign seen = true -%}
  {%- elsif seen and found == false and dd.kit -%}
    {%- assign next_run = dd -%}
    {%- assign found = true -%}
  {%- endif -%}
{%- endfor -%}
{%- assign next_shoe = plan.shoes | where: "id", next_run.shoe | first -%}

{%- capture icon_run -%}
<img class="image" width="34" height="33" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAACIAAAAhAQAAAACUqETBAAAAjklEQVR42gXBsVECURgGwH0fDBI4gg3IlWFgAB3YCw2Q2YplvLERTyMCA8bonLm5391W/t5OYeri2yg+ES6D6O+0avfnk3pYVU+1hSy7Ip4cmZ85WiakTRvi1i5HNe6qx7gnhoEwEq9X4mcm9buw9njGfGjVMx82ZFq25PayJy4D+Vp38rGCu6rq2UL28A/kGTLVTjnfvQAAAABJRU5ErkJggg==" />
{%- endcapture -%}
{%- capture icon_shoe -%}
<img class="image" width="46" height="31" src="data:image/png;base64," />
{%- endcapture -%}
{%- capture tickbox -%}
<svg viewBox="0 0 60 60" width="60" height="60" fill="none">
  <rect x="3" y="3" width="54" height="54" rx="12" stroke="black" stroke-width="3"/>
  {% if is_done %}<path d="M16 31 L26 41 L45 20" stroke="black" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>{% endif %}
</svg>
{%- endcapture -%}

<div class="layout layout--col gap--space-between">

  <div class="flex flex--col gap--none">
    <div class="flex flex--row gap--small flex--center-y">
      {{ icon_run }}
      <span class="title title--base text--uppercase">
        {{ today | date: "%A" }}{% if wk %} &middot; Week {{ wk.n }} of 36{% endif %}
      </span>
    </div>
    <div class="border--h"></div>
  </div>

  <div class="flex flex--row gap--medium flex--center-y">
    <div class="flex flex--col gap--none grow">
      {% if day %}
        <span class="title title--xxlarge" data-fit-value="true">{{ day.hero }}</span>
        {% if day.pace %}<span class="title title--medium text--gray-30 mt--3">{{ day.pace }}</span>{% endif %}
        {% if day.note %}<span class="description description--small text--gray-30 mt--1">{{ day.note }}</span>{% endif %}
      {% elsif plan.days %}
        <span class="title title--large">Nothing scheduled today</span>
        <span class="description description--small">The plan feed has no entry for {{ today }}</span>
      {% else %}
        <span class="title title--large">Waiting for the plan feed</span>
        <span class="description description--small">IDX_0 is empty. Check the polling URLs.</span>
      {% endif %}
    </div>
    {% if day.type and day.type != "rest" %}
      <div class="no-shrink">{{ tickbox }}</div>
    {% endif %}
  </div>

  <div class="grid">

    <div class="col--span-7">
      {% if day.kit %}
        <div class="flex flex--col gap--none">
          {% if band_label %}<span class="title title--large">{{ band_label }}</span>{% endif %}
          {% if delta %}
            {% for line in delta.lines limit: slots %}
              <span class="title title--small">{{ line }}</span>
            {% endfor %}
          {% else %}
            <span class="title title--small">
              {% if day.kit == "quality" %}{{ plan.kit.defaults.quality }}{% else %}{{ plan.kit.defaults.easy }}{% endif %}
            </span>
          {% endif %}
          {% for m in modlist limit: mod_cap %}
            <span class="title title--small">{{ m }}</span>
          {% endfor %}
          {% if supply != "" %}
            <span class="title title--small text--bold pt--1">{{ supply }}</span>
          {% endif %}
          <div class="flex flex--row gap--small flex--center-y pt--2">
            {{ icon_shoe }}
            {% if ice %}
              <span class="title title--small">{{ plan.kit.modifiers.ice }}</span>
            {% else %}
              <span class="title title--small">{{ shoe.short }}</span>
            {% endif %}
          </div>
        </div>
      {% elsif found %}
        <div class="flex flex--col gap--none">
          <span class="title title--large">Next run</span>
          <span class="title title--small">{{ next_run.date | date: "%a" }} &middot; {{ next_run.hero }}</span>
          <span class="label label--small text--gray-30">{{ next_run.at }} &middot; {{ next_run.pace }}</span>
          <div class="flex flex--row gap--small flex--center-y pt--2">
            {{ icon_shoe }}
            <span class="title title--small">{{ next_shoe.short }}</span>
          </div>
        </div>
      {% endif %}
    </div>

    <div class="col--span-5">
      {% if has_wx %}
        <div class="flex flex--col gap--none">
          <span class="label label--small text--uppercase text--gray-30">Now &middot; {{ now_hhmm }}</span>
          <div class="flex flex--row gap--small flex--bottom">
            <span class="value value--xxlarge value--tnums">{{ now_temp | round }}&deg;</span>
            <div class="flex flex--col gap--none">
              <span class="label label--small">{{ now_wind | round }} km/h</span>
              <span class="label label--small">{{ now_precip }} mm</span>
              {% if now_uv %}<span class="label label--small">UV {{ now_uv | round }}</span>{% endif %}
            </div>
          </div>
          <span class="label label--xsmall text--gray-30">Light {{ sunrise_t }} to {{ sunset_t }}</span>
        </div>
      {% else %}
        <span class="label label--small text--gray-30">No forecast. Kit shown is the default.</span>
      {% endif %}
    </div>

  </div>
</div>

<div class="title_bar">
  <span class="title">{% if wk %}Wk {{ wk.n }} &middot; {{ wk.demand }}{% else %}London Marathon 2027{% endif %}</span>
  <span class="instance">{% if day.cpd == 0 %}{{ day.cp }} today{% else %}{{ day.cp }} in {{ day.cpd }}d{% endif %}</span>
</div>
