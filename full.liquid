{%- comment -%} Week progress. One where lookup, no arithmetic, per the architecture note.
     Belongs in markup_shared; parked here so the footer change did not require
     rewriting that file. Move it across next time shared is written anyway. {%- endcomment -%}
{%- assign wkact = strava.weeks | where: "n", wk.n | first -%}
<div class="layout layout--col gap--space-between">

  <div class="flex flex--col gap--none">
    <div class="flex flex--row gap--small flex--center-y">
      {{ icon_run }}
      <span class="title title--base text--uppercase">
        {{ today | date: "%A" }}{% if wk %} &middot; Week {{ wk.n }} of 36{% endif %}
      </span>
    </div>
    <div class="border--h mb--3"></div>

    <div class="flex flex--row gap--medium flex--center-y">
      <div class="flex flex--col gap--none grow">
        {% if day %}
          <span class="title title--xxlarge" data-fit-value="true">{{ day.hero }}</span>
          {% if day.pace %}<span class="title title--medium text--gray-30 mt--2">{{ day.pace }}</span>{% endif %}
          {% if day.note %}<span class="description description--small text--gray-30">{{ day.note }}</span>{% endif %}
        {% elsif plan.days %}
          <span class="title title--large">Nothing scheduled today</span>
          <span class="description description--small">The plan feed has no entry for {{ today }}</span>
        {% else %}
          <span class="title title--large">Waiting for the plan feed</span>
          <span class="description description--small">IDX_0 is empty. Check the polling URLs.</span>
        {% endif %}
      </div>
      {% if day.type and day.type != "rest" %}
        <div class="no-shrink">{% if is_done %}{{ tick_done }}{% else %}{{ tick_empty }}{% endif %}</div>
      {% endif %}
    </div>
  </div>

  {%- comment -%} Indent is padding on real content, never an empty spacer element,
       and the shoe lives inside this column so it cannot drift from the kit list. {%- endcomment -%}
  <div class="grid">
    <div class="col--span-8">
      {% if act %}
        <div class="flex flex--col gap--small px--12">
          <span class="title title--large">Done</span>
          <span class="title title--base">{{ act.headline }}</span>
          {% unless act.detail == blank %}<span class="title title--base">{{ act.detail }}</span>{% endunless %}
          <span class="title title--base text--bold">{{ act.verdict }}</span>
        </div>
      {% elsif day.kit %}
        <div class="flex flex--col gap--small px--12">
          {% if band_label %}<span class="title title--large">{{ band_label }}</span>{% endif %}
          <span class="title title--base">{{ top_line }}</span>
          <span class="title title--base">{{ bot_line }}</span>
          <span class="title title--base">{{ acc_line }}</span>
          <div class="flex flex--row gap--small flex--center-y pt--2">
            {{ icon_shoe }}
            {% if is_ice %}
              <span class="title title--base">{{ plan.kit.modifiers.ice }}</span>
            {% else %}
              <span class="title title--base">{{ shoe.short }}</span>
            {% endif %}
          </div>
        </div>
      {% elsif found %}
        <div class="flex flex--col gap--small px--12">
          <span class="title title--large">Next run</span>
          <span class="title title--base">{{ next_run.date | date: "%a" }} &middot; {{ next_run.hero }}</span>
          <span class="label label--small text--gray-30">{{ next_run.at }} &middot; {{ next_run.pace }} &middot; {{ next_shoe.short }}</span>
        </div>
      {% endif %}
    </div>
    <div class="col--span-4">
      {% if has_wx %}
        <div class="flex flex--col gap--none">
          <span class="label label--small text--uppercase text--gray-30">{{ now_hhmm }}</span>
          <div class="flex flex--row gap--small flex--center-y flex--wrap">
            <span class="value value--xxlarge value--tnums">{{ now_temp | round }}&deg;</span>
            {% if is_windy %}{{ icon_wind }}{% endif %}
            {% if is_heavy %}{{ icon_rain }}{% elsif is_drizzle %}{{ icon_drizzle }}{% endif %}
            {% if is_fog %}{{ icon_fog }}{% endif %}
            {% if is_ice %}{{ icon_ice }}{% endif %}
            {% if is_uv %}{{ icon_uv }}{% endif %}
          </div>
          <span class="label label--small text--gray-30 mt--2">Light {{ sunrise_t }} to {{ sunset_t }}</span>
          <span class="label label--small text--gray-30">{{ now_wind | round }} km/h &middot; {{ now_precip }} mm{% if now_uv %} &middot; UV {{ now_uv | round }}{% endif %}</span>
        </div>
      {% else %}
        <span class="label label--small text--gray-30">No forecast. Kit shown is the default.</span>
      {% endif %}
    </div>
  </div>

  {%- comment -%} Conditional supplies only. Same px--12 as the kit column, so the
       left edges match without either side relying on an empty element. {%- endcomment -%}
  <div class="flex flex--col gap--none">
    {% unless act %}{% if day.fuel or need_fluid or is_dark %}
      <div class="border--h mb--2"></div>
      <div class="flex flex--row gap--large flex--center-y px--12">
        {% if day.fuel %}<div class="flex flex--row gap--small flex--center-y">{{ icon_gel }}<span class="title title--base">{{ day.fuel_label }}</span></div>{% endif %}
        {% if need_fluid %}<div class="flex flex--row gap--small flex--center-y">{{ icon_bottle }}<span class="title title--base">{{ plan.kit.modifiers.fluid }}</span></div>{% endif %}
        {% if is_dark %}<div class="flex flex--row gap--small flex--center-y">{{ icon_hivis }}<span class="title title--base">{{ plan.kit.modifiers.dark }}</span></div>{% endif %}
      </div>
    {% endif %}{% endunless %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{% if wk and wk.runs > 0 %}Wk {{ wk.n }} &middot; run {{ wkact.runs | default: 0 }} of {{ wk.runs }}{% elsif wk %}Wk {{ wk.n }} &middot; {{ wk.demand }}{% else %}London Marathon 2027{% endif %}</span>
  <span class="instance">{% if day.cpd == 0 %}{{ day.cp }} today{% else %}{{ day.cp }} in {{ day.cpd }}d{% endif %}</span>
</div>
